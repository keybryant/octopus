{
  "name": "octopus",
  "version": "0.1.0",
  "description": "octopus workbench shell plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./vite": {
      "types": "./lib/types/vite-plugin.d.ts",
      "default": "./lib/vite-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "web-dist", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build web --config web/vite.config.ts && vite build web --config web/vendor.config.ts && tsc -p web/tsconfig.json",
    "test": "vitest run && vitest run --root web",
    "dev:web": "vite web",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "octopus-ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "octopus-auth": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "octopus-auth": "file:../octopus-auth",
    "octopus-users": "file:../octopus-users",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
