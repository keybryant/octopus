{
  "name": "octopus-requirements",
  "version": "0.1.0",
  "description": "Requirements management plugin for the octopus workbench",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web/dist",
    "cordis.patch.yml",
    "README.md"
