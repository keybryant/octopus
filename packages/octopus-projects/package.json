    "octopus": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "octopus": "file:../octopus",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
